{
  "name": "den",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "🦊 Den — a cozy cockpit for Claude-driven development",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/fix-pty.mjs",
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/electron/main.cjs",
    "rebuild:electron": "electron-rebuild -f -o node-pty,better-sqlite3",
    "rebuild:node": "npm rebuild node-pty better-sqlite3 && node scripts/fix-pty.mjs",
    "app": "npm run rebuild:electron && npm run build && npm run build:electron && electron .",
    "app:run": "npm run build && npm run build:electron && electron .",
    "pack": "npm run build && npm run build:electron && electron-builder --dir",
    "dist": "npm run build && npm run build:electron && electron-builder",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.0.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
